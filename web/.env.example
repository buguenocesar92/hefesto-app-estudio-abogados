# ---------------------------------------------------------------------------
# Variables de la INTERFAZ (Nuxt)
# ---------------------------------------------------------------------------
#
# NINGÚN valor de este archivo es real.
#
# `NUXT_SESSION_COOKIE` es la cookie de sesión que el navegador manda a la API.
# La API es la que valida si la sesión existe; esta interfaz solo la reenvía.
# Por eso la interfaz no puede inventar permisos: no los tiene.
# ---------------------------------------------------------------------------

# Dirección interna de la API, desde la red de Docker. No se publica.
NUXT_API_BASE=http://api:8080

# Dirección pública de la interfaz.
NUXT_PUBLIC_BASE=http://localhost:3000

# Cookie de sesión. En producción tiene que ser `secure`.
NUXT_SESSION_COOKIE=estudio_session