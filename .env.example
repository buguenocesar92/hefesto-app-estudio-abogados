# ---------------------------------------------------------------------------
# Variables de entorno de la APLICACIÓN DE ESTUDIOS DE ABOGADOS (para `docker compose`)
# ---------------------------------------------------------------------------
#
# Esta plantilla la usan los dos compose:
#
#   docker compose -f deploy/docker-compose.dev.yml  --env-file .env up -d
#   docker compose -f deploy/docker-compose.prod.yml --env-file .env.prod up -d
#
# En producción se copia a `.env.prod`, que NO se versiona.
#
# NINGÚN valor de este archivo es real. Los secretos se generan con:
#
#   openssl rand -base64 48   # para APP_KEY
#   php artisan key:generate --show
#   openssl rand -base64 60 | tr -d '\n'   # para AUTHENTIK_SECRET_KEY
#   openssl rand -hex 32                   # para AUTHENTIK_BOOTSTRAP__TOKEN
#
# Ojo: PostgreSQL no acepta contraseñas de más de 99 caracteres.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Aplicación
# ---------------------------------------------------------------------------
APP_ENV=local
APP_KEY=
APP_URL=http://localhost:8000
APP_WEB_URL=http://localhost:3000

# Dominio público del estudio. Lo usa Caddy para el certificado TLS.
ESTUDIO_DOMINIO=estudio.ejemplo.cl

# ---------------------------------------------------------------------------
# Base de datos de la APLICACIÓN
# ---------------------------------------------------------------------------
# El rol de esta conexión NO puede ser superusuario ni tener BYPASSRLS. Con
# cualquiera de las dos, PostgreSQL ignora las políticas de Row Level Security
# y un estudio vería los expedientes de otro. Lo comprueba:
#   php artisan estudio:verificar-aislamiento
DB_DATABASE=estudio_abogados_dev
DB_USERNAME=estudio_app
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Rol de arranque de PostgreSQL
# ---------------------------------------------------------------------------
# El rol de arriba es el de la APLICACION. Este es el de arranque: la imagen
# oficial lo crea como superusuario, asi que la aplicacion NUNCA conecta con el.
# Con superusuario, PostgreSQL ignora las politicas de Row Level Security y una
# empresa podria ver los datos de otra. Los dos detalles, en docs/03.
DB_ADMIN_USERNAME=estudio_abogados_admin
DB_ADMIN_PASSWORD=

DB_HOST=postgres
DB_PORT=5432

# Solo en producción: Redis exige contraseña en el compose de producción.
REDIS_PASSWORD=

# ---------------------------------------------------------------------------
# VIGILANCIA DE PLAZOS
# ---------------------------------------------------------------------------
# DÍAS DE AVISO
#
# Aquí NO hay ningún plazo legal. Es una alarma interna: cuántos días antes de
# la fecha que el abogado escribió, el sistema avisa. Es un número operativo
# del estudio (el socio lo elige), no un término procesal.
#
# Si se deja VACÍO, el sistema NO marca nada: no hay con qué comparar y un
# "rojo" con un número inventado sería peor que un tablero con huecos.
# Ver docs/05.
ESTUDIO_DIAS_ALERTA_PLAZO=
ESTUDIO_DIAS_ALERTA_CRITICA=

# Frecuencia con que el vigilante repasa los plazos (cron).
ESTUDIO_VIGILANCIO_PLAZOS_CRON="0 7 * * *"

# ---------------------------------------------------------------------------
# DOCUMENTOS
# ---------------------------------------------------------------------------
# Carpeta donde se guardan los archivos. Debe estar en un volumen con respaldo.
DOCUMENTOS_PATH=/var/www/html/storage/app/documentos

# Si el aviso de "este documento ya estaba en otro expediente" se manda por
# correo. El aviso se registra igual en la bitácora aunque esto esté en false.
ESTUDIO_AVISAR_DOCUMENTO_DUPLICADO=false

# ---------------------------------------------------------------------------
# Authentik (proveedor de identidad)
# ---------------------------------------------------------------------------
AUTHENTIK_SECRET_KEY=
AUTHENTIK_BOOTSTRAP__EMAIL=akadmin@hefestostudio.cl
AUTHENTIK_BOOTSTRAP__PASSWORD=
AUTHENTIK_BOOTSTRAP__TOKEN=

# Base de datos propia de Authentik (no es la de la aplicación).
AUTHENTIK_POSTGRESQL__NAME=authentik
AUTHENTIK_POSTGRESQL__USER=authentik
AUTHENTIK_POSTGRESQL__PASSWORD=

# Valores que consume la API (config/authentik.php).
AUTHENTIK_ISSUER=https://id.ejemplo.cl/application/o/estudio-abogados/
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback
AUTHENTIK_SCOPES=openid profile email
AUTHENTIK_ALGORITMO=RS256

# ---------------------------------------------------------------------------
# Correo (avisos de plazos y colisiones)
# ---------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=estudio@ejemplo.cl
MAIL_FROM_NAME="Gestión de Estudios de Abogados"

# ---------------------------------------------------------------------------
# Certificados
# ---------------------------------------------------------------------------
ACME_EMAIL=admin@hefestostudio.cl

# ---------------------------------------------------------------------------
# Solo producción: imágenes ya construidas
# ---------------------------------------------------------------------------
# En producción el compose usa imágenes construidas (no `build`), para que el
# despliegue sea reproducible y no dependa de que el código fuente esté en el
# servidor.
# API_IMAGE=hefesto/estudio-abogados-api:1.0.0
# WEB_IMAGE=hefesto/estudio-abogados-web:1.0.0